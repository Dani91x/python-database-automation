diff --git a/Betfair/stream/tennis_live/tests/test_r2_tennis_paper_al_nuovo_avvio_2026_09_25.py b/Betfair/stream/tennis_live/tests/test_r2_tennis_paper_al_nuovo_avvio_2026_09_25.py
