+def test_soglia_legge_i_parametri_non_le_costanti():
+    p = _p(veto_p_under35_soglia_150=0.70, veto_p_under35_soglia_200=0.50)
+    assert E.soglia_veto_under35(1.75, p) == pytest.approx(0.60, abs=1e-9)
