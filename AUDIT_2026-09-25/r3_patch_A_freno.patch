+    # ``_refresh_settings`` riscrive la copia di PROCESSO dei settings del worker
+    # (kill_switch compreso): va ripristinata, o i test dopo vedrebbero il freno
+    monkeypatch.setattr(W, "_SETTINGS", dict(W._SETTINGS))
