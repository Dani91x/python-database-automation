+        max_exposure_per_league: null, updated_at: '2026-09-25T20:00:00+00:00',
+        order_mode: 'paper', order_mode_updated_at: '2026-09-25T12:00:00+00:00',
+        order_mode_updated_by: 'avvio_app', order_mode_boot_id: 'boot-1',
