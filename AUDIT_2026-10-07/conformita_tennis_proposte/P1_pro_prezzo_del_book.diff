@@ -0,0 +1,92 @@
+"""07/10 (cantiere conformita' tennis) - tennis_pro: il PREZZO del runner e' quello
+del book, non l'ultimo scambiato.
+
+Reperto misurato sulla registrazione vera 35790089 (Barrios Vera - Simakin,
+07/07/2026): l'ultimo scambiato (`last_price_traded`) resta fermo per minuti su
+un mercato poco liquido. Alle 13:54:27 Simakin aveva `ltp` 1,19 (scambiato due
+minuti prima) e il book 2,18 / 2,32; Barrios `ltp` 6,40 e il book 1,76 / 1,84.
+Il bot ha visto Simakin come «favorito cortissimo <= 1,20» ed e' entrato in
+`compressed_fav` su un runner a 2,20 che non era nemmeno il favorito.
+Sulla registrazione il favorito per `ltp` differisce da quello del book in
+921 book su 5.212.
+
+I finti hanno le stesse chiavi del dizionario `px` di produzione
+(`process_market_book`: bb, bl, sb, sl, ltp).
+"""
+from betfairlightweight import filters
+
+from Betfair.stream.tennis_scalper.tennis_pro_bot import TennisProStrategy
+from Betfair.stream.tennis_scalper.tennis_score import TennisScore
+
+
+class _Mercato:
+    market_id = "1.259745327"
+
+    class _Blotter:
+        def strategy_orders(self, _s):
+            return []
+    blotter = _Blotter()
+
+
+def _bot(**params):
+    # variante BASE esplicita (trend/adapt/maker spenti) e dry-run: si guarda
+    # SOLO la decisione d'ingresso, non l'ordine
+    base = {"stake": 2.0, "dry_run": True, "trend": False, "adapt": False,
+            "maker": False, "surface": "clay"}
+    base.update(params)
+    return TennisProStrategy(
+        market_filter=filters.streaming_market_filter(market_ids=["1.259745327"]),
+        pro_params=base,
+        name_to_sel={"Marcelo Tomas Barrios V": 9633138, "Ilia Simakin": 35635727})
+
+
+def _riga(bb, bl, ltp, sb=100.0, sl=100.0):
+    return {"bb": bb, "bl": bl, "sb": sb, "sl": sl, "ltp": ltp}
+
+
+def _px_13_54_27():
+    # i numeri del book reale alle 13:54:27 (tie-break del terzo set, 6-6)
+    return {9633138: _riga(1.76, 1.84, 6.4), 35635727: _riga(2.18, 2.32, 1.19)}
+
+
+def test_favorito_e_quello_del_book_non_dell_ultimo_scambiato():
+    assert TennisProStrategy._favourite(_px_13_54_27()) == 9633138
+
+
+def test_favorito_senza_book_ripiega_sull_ultimo_scambiato():
+    # nessun lato quotato: resta l'unico prezzo disponibile (come `_track_px`)
+    px = {1: {"bb": None, "bl": None, "ltp": 1.4}, 2: {"bb": None, "bl": None, "ltp": 3.0}}
+    assert TennisProStrategy._favourite(px) == 1
+
+
+def test_compressed_fav_non_scatta_su_un_ltp_fermo():
+    s = _bot()
+    s.score = TennisScore(event_id="35790089", sets_home=1, sets_away=1,
+                          games_home=6, games_away=6, point_home="6", point_away="6")
+    assert s._sig_compressed_fav(_Mercato(), _px_13_54_27()) is False
+    assert "1.259745327" not in s._trade
+
+
+def test_compressed_fav_scatta_sul_book_anche_con_ltp_fermo_alto():
+    # 13:27:08 reale: Simakin 1,16 / 1,17 a book, ultimo scambiato 1,36
+    s = _bot()
+    s.score = TennisScore(event_id="35790089", sets_home=1, sets_away=1,
+                          games_home=3, games_away=5)
+    px = {9633138: _riga(6.6, 7.0, 7.0), 35635727: _riga(1.16, 1.17, 1.36)}
+    assert s._sig_compressed_fav(_Mercato(), px) is True
+    assert s._trade["1.259745327"]["sel"] == 35635727
+
+
+def test_prezzo_d_inizio_set_e_quello_del_book():
+    # 12:35:52 reale, primo book del terzo set: Barrios 1,51 / 1,57, ultimo
+    # scambiato 1,40 (di prima che il set finisse). Il «salto» del fade si
+    # misura da qui: con l'ltp fermo il bot vedeva 17 tick di salto a 0-0 nel
+    # set, senza nessun game giocato.
+    s = _bot()
+    px = {9633138: _riga(1.51, 1.57, 1.40), 35635727: _riga(2.74, 2.96, 3.3)}
+    s.score = TennisScore(event_id="35790089", sets_home=1, sets_away=1,
+                          games_home=0, games_away=0, home_name="Marcelo Tomas Barrios V",
+                          away_name="Ilia Simakin")
+    s._track_sets("1.259745327", px)
+    assert s._set_start_px[("1.259745327", 9633138, 2)] == (1.51 + 1.57) / 2.0
+    assert s._sig_fade(_Mercato(), "1.259745327", px) is False
