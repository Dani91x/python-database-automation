+                            "sbilancio": round(abs(w - l), 2)})
+        role = RUOLI_CHIUSURA_DI_SERIE.get(key, "manual_close")
+        candidati: List[Tuple[str, GreenupPlan]] = []
+        plan = cv.plans.get(key)
