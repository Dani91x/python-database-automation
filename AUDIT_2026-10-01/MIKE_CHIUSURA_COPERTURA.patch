+"""Minimi di Betfair .it, fonte UNICA del repo (nessuna dipendenza).
+
+# Ordine DIRETTO: punta 1,00 e banca 1,00 (puntata del backer), al centesimo, nessun passo.
+# Place-and-trim: importo FINALE dopo il taglio mai sotto 0,50; parcheggio sempre >= 1,00.
+# Mai sotto 0,50: e' il floor di legge, nessun trucco ci scende.
+# Fonti: Nota informativa betfair.it; blog ufficiale betfair.it 30/10/2023 (banca 1 EUR
+# sulla puntata del backer); DM 47/2013 art. 8 (floor 0,50).
+"""
+from __future__ import annotations
+
+IT_MIN_BACK = 1.00
+IT_MIN_LAY = 1.00
+IT_FLOOR_LEGGE = 0.50
+SUBMIN_IMPORTO_FINALE_MIN = 0.50
diff --git a/Betfair/mike/tests/test_mike_chiusura_copertura_2026_10_01.py b/Betfair/mike/tests/test_mike_chiusura_copertura_2026_10_01.py
