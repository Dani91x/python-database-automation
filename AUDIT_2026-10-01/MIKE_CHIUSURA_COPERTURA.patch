+    ctx = in_chiusura(rifiutata, attempts=1)
+    rifiuta(ctx, rifiutata)
+    d = E.decide(ctx, foto(now=T0 + 10), params())
+    [a] = piazzamenti(d)
+    assert (a.role, a.selection, a.side, a.size, a.price) == ("over_close", E.SEL_UNDER,
+                                                             "back", 7.55, 1.03)
