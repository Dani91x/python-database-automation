+const O503 = tradeOmega({ id: 503, event_id: 'E503', status: 'lost', pnl: -0.5,
+    placed_at: '2026-10-01T12:00:00.000Z', settled_at: '2026-10-01T12:58:00.000Z' });
+// Mike 7001 + copertura 7002
