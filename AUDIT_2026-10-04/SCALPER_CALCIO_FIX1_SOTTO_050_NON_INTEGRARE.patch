@@ -0,0 +1,150 @@
+"""CERTIFICAZIONE SCALPER CALCIO (04/10) - resto di chiusura sotto 0,50 su .it.
+
+Reperto del replay 35797769 [base] (KO dal 02/10, commit 09072ca che ha reso il
+banco fedele ai minimi .it, `backtest/minimi_banco.py`): le uscite esatte dello
+scalper spezzano la chiusura in parte diretta + RESTO via place-and-trim; per un
+resto sotto 0,50 (0,30 / 0,28 / 0,19 / 0,14 / 0,13 / 0,11 nel replay) Betfair
+.it rifiuta il rimpiazzo (CANCELLED_NOT_PLACED:INVALID_BET_SIZE, misura sul
+conto del 13/09) e la sequenza si dichiarava DONE ("ordine sotto-minimo a
+riposo") con un sostituto che a mercato NON esiste: K1 x4 (il bot segue un
+ordine fantasma), poi il resto restava scoperto senza dichiarazione.
+
+Regola unica del 01-02/10 (`trading.submin.verifica_importo_finale`): l'importo
+FINALE di un place-and-trim e' almeno `SUBMIN_IMPORTO_FINALE_MIN` (0,50); sotto
+non si tenta mai, il resto si dichiara. Lo scalper costruiva lo `SubminState` a
+mano e la saltava.
+
+Bot VERO su Flumine VERO (banco del cantiere S: client paper della sessione,
+esecuzione differita di 1 e 4 book) con la regola dell'exchange simulato del
+banco montata (`minimi_banco.minimi_it_su_flumine`): stessi oggetti del replay.
+"""
+from __future__ import annotations
+
+from typing import Any, List
+
+import pytest
+
+from Betfair.stream.backtest import minimi_banco as MB
+from Betfair.stream.live_order_build import SUBMIN_IMPORTO_FINALE_MIN
+from Betfair.stream.tests import test_cantiere_s_scalper_ko_2026_09_29 as SCT
+from Betfair.stream.tests.test_cantiere_s_scalper_ko_2026_09_29 import (  # noqa: F401
+    differita,
+    esecuzione_differita,
+    orologio_mercato,
+)
+
+
+@pytest.fixture
+def exchange_it():
+    """La regola dell'exchange simulato del banco (minimi .it) per il test."""
+    with MB.minimi_it_su_flumine() as registro:
+        yield registro
+
+
+def _k1(b: SCT.Banco, i: int) -> List[str]:
+    """K1 del banco: uno slot VIVO non segue mai un ordine che il blotter del
+    mercato non conosce (`certificazione._k1`, stessa regola)."""
+    slot = b.slot()
+    if str(slot.status) not in SCT.CERT.STATI_SLOT_VIVI:
+        return []
+    noti = {str(o.id) for o in b.market.blotter}
+    c = SCT.CERT.credenze(b.strat)
+    out = []
+    for riga in c:
+        if riga["chiave"] != (SCT.MID, SCT.SEL):
+            continue
+        for o in SCT.CERT.ordini_seguiti(riga):
+            if str(o.id) not in noti:
+                out.append("book %d K1: slot %s segue %s %s %.2f @%s fuori dal blotter"
+                           % (i, slot.status, o.id, o.side, float(o.order_type.size),
+                              o.order_type.price))
+    return out
+
+
+def _fino_al_done(b: SCT.Banco, svuota: Any, n: int) -> List[str]:
+    """Giri fino alla chiusura DICHIARATA (DONE). Ci si ferma li': il resto
+    accettato viene poi dimenticato dal reset del ciclo dopo, decisione aperta
+    dell'utente dal 29/09 (referto del cantiere S par. 7), fuori da questo test
+    (lo stesso fanno i test del cantiere S3)."""
+    viol: List[str] = []
+    for i in range(n):
+        svuota()
+        b.book()
+        viol += _k1(b, i) + SCT.invarianti(b, i)
+        if b.slot().status == SCT.SB.DONE:
+            break
+    return viol
+
+
+@pytest.mark.parametrize("lato,size", [("LAY", 0.2), ("LAY", 0.4), ("BACK", 0.3)])
+def test_resto_sotto_050_nessuna_sequenza_e_dichiarato(lato, size, differita,
+                                                      orologio_mercato, exchange_it):
+    """Posizione abbinata il cui intero green e' sotto 0,50: nessuna sequenza
+    place-and-trim (Betfair rifiuterebbe il rimpiazzo), nessun ordine seguito
+    fuori dal blotter, UNA riga CRITICAL `sotto_minimo_non_piazzabile` col
+    motivo, lo slot chiude DICHIARANDO il residuo (`residual_ok`), nessun
+    ordine vivo, esposizione entro la tolleranza dichiarata."""
+    b = SCT._in_flatten(lato, 2.22, size)
+    orologio_mercato["banco"] = b
+    viol = _fino_al_done(b, differita, 80)
+    slot = b.slot()
+    assert viol == [], viol[:3]
+    assert slot.status == SCT.SB.DONE, slot.status
+    assert [r for r in b.righe if r[0] == "submin_start"] == []
+    crit = [r for r in b.righe if r[0] == "sotto_minimo_non_piazzabile"]
+    assert len(crit) == 1, crit
+    assert crit[0][1]["level"] == "CRITICAL"
+    assert "SOTTO_MINIMO_NON_PIAZZABILE" in crit[0][1]["msg"]
+    assert crit[0][1]["size"] < SUBMIN_IMPORTO_FINALE_MIN
+    assert slot.residual_ok is True
+    assert SCT.vivi(b.market, b.strat) == []
+    w, l = SCT.esposizione_vera(b.market, b.strat)
+    assert abs(w - l) <= SCT.CERT.tolleranza_slot(slot) + 1e-9, (w, l)
+    # il banco non ha visto nessun rimpiazzo rifiutato (nessun tentativo)
+    assert [r for r in exchange_it.rifiutati if r["tipo"] == MB.SOSTITUZIONE] == []
+
+
+def test_parte_diretta_piu_resto_sotto_050_il_bot_non_segue_fantasmi(
+        differita, orologio_mercato, exchange_it):
+    """Il caso del replay (selezione 22, 17:00:29): LAY 2,80 @2,22 abbinata,
+    chiusura BACK ~2,83 = 2,50 diretti + resto 0,33. Prima: sequenza per 0,33,
+    rimpiazzo rifiutato dall'exchange, slot che seguiva il sostituto inesistente
+    (K1). Ora: la parte diretta parte, il resto si dichiara, mai un ordine
+    seguito fuori dal blotter."""
+    b = SCT._in_flatten("LAY", 2.22, 2.8)
+    orologio_mercato["banco"] = b
+    viol = _fino_al_done(b, differita, 120)
+    slot = b.slot()
+    assert viol == [], viol[:3]
+    assert slot.status == SCT.SB.DONE, slot.status
+    diretti = [r for r in b.righe if r[0] == "place" and r[1].get("side") == "BACK"]
+    assert diretti and float(diretti[0][1]["size"]) == 2.5, diretti
+    assert [r for r in b.righe if r[0] == "submin_start"] == []
+    assert len([r for r in b.righe if r[0] == "sotto_minimo_non_piazzabile"]) == 1
+    assert [r for r in exchange_it.rifiutati if r["tipo"] == MB.SOSTITUZIONE] == []
+
+
+def test_resto_da_050_in_su_resta_al_place_and_trim(differita, orologio_mercato,
+                                                    exchange_it):
+    """Il confine: un resto di 0,50 (LAY 0,50 @2,22 -> BACK 0,50) NON e' sotto il
+    minimo finale: la sequenza parte come prima e nessuna riga CRITICAL."""
+    b = SCT._in_flatten("LAY", 2.22, 0.5)
+    orologio_mercato["banco"] = b
+    viol = _fino_al_done(b, differita, 150)
+    assert viol == [], viol[:3]
+    assert [r for r in b.righe if r[0] == "submin_start"], b.righe[-5:]
+    assert [r for r in b.righe if r[0] == "sotto_minimo_non_piazzabile"] == []
+
+
+def test_ultima_spiaggia_resto_sotto_050_e_davvero_non_piazzabile():
+    """`_resto_davvero_non_piazzabile`: una chiusura BACK 0,30 (sotto 0,50, con
+    le uscite esatte, nessuna sequenza fatta) e' davvero non piazzabile; una
+    BACK 1,20 (place-and-trim possibile, tetto non raggiunto) no."""
+    b = SCT.Banco()
+    b.book()
+    strat, slot = b.strat, b.slot()
+    assert strat.exact_exits and not strat.dry_run
+    # posizione LAY S @2,22 (se vince -S*1,22, se perde +S): chiusura BACK
+    # ~S*2,22/2,20 al best back 2,20
+    assert strat._resto_davvero_non_piazzabile(slot, -0.30 * 1.22, 0.30, 2.20, 2.22) is True
+    assert strat._resto_davvero_non_piazzabile(slot, -1.20 * 1.22, 1.20, 2.20, 2.22) is False
