  "cards": [
    {
      "dot": "emerald",
      "title": "Cosa fa Mike",
      "items": [
        "Punta Over 4,5 per coprire 1,2 volte la perdita dell'Under, netto commissione 5%",
        "Quota limite 2 tick sotto il miglior prezzo; se non si abbina in 10 s riprezza",
        "Dopo un gol precoce copre in due meta': 120 s dal gol e 180 s dopo la prima"
      ]
    },
    {
      "dot": "amber",
      "title": "Cosa decidi tu",
      "items": [
        "La copertura e' sempre automatica, anche con le uscite manuali",
        "Dopo 3 rifiuti uguali la copertura si ferma: la riaccendi con Riprendi"
      ]
    },
    {
      "dot": "rose",
      "title": "Punti da guardare",
      "items": [
        "Con 3 o piu' gol Mike non copre",
        "Un freno di sicurezza puo' contare come rifiuto e bloccare la copertura",
        "Con prezzi non vivi non parte nessuna copertura"
      ]
    }
