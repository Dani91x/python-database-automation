  "cards": [
    {
      "dot": "emerald",
      "title": "Come parte un ordine",
      "items": [
        "Mike prima scrive la riga dell'ordine, poi lo manda",
        "Ogni ordine a mercato e' tutto o niente: il non abbinato sparisce subito",
        "Solo la banca d'uscita resta in coda sul libro"
      ]
    },
    {
      "dot": "amber",
      "title": "Paper e live",
      "items": [
        "Paper: l'ordine lo esegue il simulatore con ritardo, coda e parziali",
        "Live: l'ordine va a Betfair; parte solo con l'interruttore soldi veri acceso"
      ]
    },
    {
      "dot": "rose",
      "title": "Punti da guardare",
      "items": [
        "L'ultimo ingresso parte tutto o niente e cade al fischio, anche se la regola dice che resta in gioco",
        "In live una banca scaduta alla sospensione finisce sempre in verifica"
      ]
    }
  ]
