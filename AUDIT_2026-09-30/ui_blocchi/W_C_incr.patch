+
+function op(p: Partial<OperazionePerChiusura> & Pick<OperazionePerChiusura, 'bot' | 'id'>): OperazionePerChiusura {
+    return { eventId: '35001', marketId: '1.35', modalita: 'live', stato: 'open', chiudeId: null, pnl: null, ...p };
