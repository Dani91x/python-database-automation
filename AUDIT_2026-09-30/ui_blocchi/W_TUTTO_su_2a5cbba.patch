+        id: 7001, bot: 'mike', selezione: 'Under 3.5 Goals', lato: 'back', prezzo: 1.5, size: 10,
+        stato: 'open', pnl: null, modalita: 'live', at: '2026-09-30T18:00:00.000Z', quale: null,
