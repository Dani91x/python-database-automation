+
+/** La riga della scheda come serve al piano (forma strutturale di `OperazionePartita`). */
+export interface OperazionePerChiusura {
+    bot: Bot;
+    id: number;
+    eventId?: string;
+    marketId: string | null;
+    modalita: 'paper' | 'live' | null;
+    stato: string;
