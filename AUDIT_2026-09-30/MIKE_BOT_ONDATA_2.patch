+    run(db, mk, NOW, [row(_payload_finita())])
+    assert len(_annulli_al_runner(runner)) == 1
+    assert _gamba(db, "over_cover-0-7")["status"] == E.STATUS_RECONCILE
+    assert state(db) == "SETTLING"
