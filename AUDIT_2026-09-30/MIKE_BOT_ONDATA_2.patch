+    telemetria del motore piu' ``state`` e ``ciclo`` come le altre righe."""
+    tele = d.telemetry if isinstance(getattr(d, "telemetry", None), dict) else {}
+    scritti = [str(x) for x in (extra.get("resti_scritti") or [])]
