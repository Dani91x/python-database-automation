+    sf.ordine(999.0, "1.2", "lay")
+    sf.firma("chiusura|c0", 1000.0)
+    sf.esecuzione(1001.0)
+    v = sf.giro(1001.0 + CERT.FIRMA_ESEGUITA_ENTRO_S + 1.0, proposta_viva=False,
