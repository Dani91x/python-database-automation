+    uguale = stato1 == stato0
+    esiti.append(uguale)
+    print(f'git status finale identico a quello di partenza: {uguale}')
+    print(f'\nESITO: {sum(esiti)}/{len(esiti)} come atteso')
+    return 0 if all(esiti) else 1
+
+
+if __name__ == '__main__':
+    sys.exit(main())
