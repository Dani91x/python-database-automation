+t = ''.join(c if ord(c) < 128 else BS + 'u%04x' % ord(c) for c in t)
+open(p, 'w', encoding='utf-8', newline='').write(t)
+print('non ASCII rimasti:', sum(1 for c in t if ord(c) > 127))
