++
++PATH = 'frontend/src/components/live/ScalperPanel.tsx'
++master = subprocess.run(['git', 'show', 'master:' + PATH], capture_output=True, check=True).stdout
++master_t = master.decode('utf-8-sig').replace('\r\n', '\n')
