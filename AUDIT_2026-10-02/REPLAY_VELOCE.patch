-+    for i, o in enumerate(order_package):
-+        resto = o.simulated.size_remaining
-+        nuovo = o.trade.create_order_replacement(o, 3.0, resto, None)
-+        nuovo.risposta = nuovo.simulated.place(order_package, None, {}, 100 + i)
-+        o.nuovo = nuovo
