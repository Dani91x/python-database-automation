+    assert tipi.count("meta") == 3 and tipi.count("markets") == 3
+    assert ("markets", [_MID], [10.0]) in vera["eventi_ascolto"]
+
+
+def test_chiusura_con_log_info_acceso_e_la_vera(monkeypatch):
