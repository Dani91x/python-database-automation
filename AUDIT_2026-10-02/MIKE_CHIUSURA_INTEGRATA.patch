+# 4. controllo L1 del banco: anche la punta d'apertura sotto 0,50
+# ===========================================================================
+def _l1(azioni, **p):
+    ctx = E.MatchCtx(state="WATCH", legs=[])
+    snap = foto()
+    d = E.Decision("PRE_ENTRY_PENDING", azioni, "prova")
+    return CERT._l1(ctx, snap, d, params(**p))
+
