+def chiusura_35():
+    """La banca Under 3,5 abbinata alle 19:07:01 (6,21 @ 1,24)."""
+    return gamba("under_close", E.MARKET_OU35, E.SEL_UNDER, "lay", 1.24, 6.21,
+                 ref="under_close-0-5", placed_at=T0)
