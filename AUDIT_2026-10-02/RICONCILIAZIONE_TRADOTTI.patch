+     "                if X.ricorda_tradotto(m_rec, d.get(\"betfair\") or {}):",
+     "                if False:"),
+    # ---------------------------------------------------------------- D3 coda e REST
+    ("D3-a", "worker: la riga di coda non si traduce (difetto D3)", LOW_,
+     "    if not (isinstance(params, dict) and params.get(PARAM_EQUIVALENTE)):\n        return None",
