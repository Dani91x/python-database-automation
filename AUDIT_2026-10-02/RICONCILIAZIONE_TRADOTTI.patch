+    esito = _chiudi(db, _Mercato())
+    assert esito["annulli"][0]["esito"] == "accodato"
+    assert db.queue[-1]["action"] == "cancel" and db.queue[-1]["bet_id"] == "SIM1"
+    assert db.queue[-1]["client_ref"] == "safe-t1-cancel"
+    assert tr["id"]
