+        scrivi("\n== 3) MUTAZIONE E: le due corse di Mike senza azzerare l'avviso di processo")
+        muta(MIKE, RIGA_MIKE)
+        ok &= esito("(e) file Mike legge_canale da solo", "ROSSO", (MIKE_REL,))
+        MIKE.write_bytes(orig_m)
