-        const giocati = minuto ?? 0;
-        const sh = gol.filter(([m, s]) => s === 'h' && m <= giocati).length;
-        const sa = gol.filter(([m, s]) => s === 'a' && m <= giocati).length;
-        const resto = Math.max(0.01, (90 - Math.min(90, giocati)) / 90);
